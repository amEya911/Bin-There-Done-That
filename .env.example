# Copy to .env.local. Do not commit credentials.
DATA_BACKEND=postgres
# Supabase Free project. All of these values are server-only.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=bin-evidence
# Use the IPv4-compatible transaction pooler shown in Supabase Connect.
DATABASE_HOST=
DATABASE_PORT=6543
DATABASE_USER=postgres.YOUR_PROJECT_REF
DATABASE_PASSWORD=
DATABASE_NAME=postgres
# Verify TLS with the supplied public Supabase CA certificate.
DATABASE_SSL_CA_FILE=supabase/certs/prod-ca-2021.crt
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Choose a long, unique password to enable management and presenter access.
ADMIN_PASSWORD=
# SQLite fallback/testing only. Runtime photos use Supabase when backend=postgres.
TRASHME_DATA_DIR=.data
# Set the HTTPS address used by phones (optional on localhost).
APP_ORIGIN=
# Selected evidence is removed after this many days.
EVIDENCE_RETENTION_DAYS=7
DAILY_SCAN_LIMIT=500
SESSION_SCAN_LIMIT=100
